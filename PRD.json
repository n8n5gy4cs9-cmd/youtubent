{
  "name": "Youtuben't",
  "summary": "Desktop app: YouTube URL -> editable screenshot timeline -> funny storyboard (PNG/JPG/PDF).",
  "platforms": {
    "now": [
      "macOS arm64"
    ],
    "later": [
      "windows",
      "linux"
    ]
  },
  "stack": {
    "python": "3.14 (3.13 ok)",
    "gui": "PySide6",
    "packaging": "PyInstaller",
    "tests": "pytest",
    "added": [
      "yt-dlp",
      "imageio-ffmpeg",
      "Pillow"
    ],
    "dropped_from_template": [
      "playwright",
      "httpx",
      "selectolax"
    ]
  },
  "rules": [
    "core/ has no Qt imports",
    "keep simple, no over-engineering",
    "update task.md and PRD.json after every task",
    "commit every task"
  ],
  "features": [
    "video import",
    "auto points even/random",
    "timeline editor",
    "frame preview",
    "gallery reorder/remove",
    "storyboard grid",
    "captions+timestamps",
    "export png/jpg/pdf",
    "project save/load",
    "shorts support"
  ],
  "modules": {
    "core": [
      "models",
      "urls",
      "downloader",
      "frames",
      "points",
      "storyboard",
      "captions",
      "settings"
    ],
    "ui": [
      "theme",
      "main_window",
      "preview",
      "timeline",
      "gallery",
      "side_panels",
      "workers"
    ],
    "tools": [
      "make_sprites"
    ]
  },
